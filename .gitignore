# ============ MobileApp-DeepDev 根 .gitignore ============
# HBuilderX 构建缓存 / 云打包产物（含 APK、证书 keystore——一律不随源码上传）
unpackage/
.hbuilderx/
*.log
node_modules/
# 本机生成的 APK / 根目录预览产物（源码与壳内 assets 另行入库）
APK/
/assets/
/index.html
/icon.svg
/manifest.webmanifest
/registerSW.js
/sw.js
/pdf.worker.min.mjs
/zhenti/

# 本机构建/交接脚本与说明文档（本地保留，不上传 GitHub）
/_*.ps1
/_*.md
/开发说明.md
# 本地备用 PWA 产物（Cloudflare Pages 由 ios-trial 分支实时构建，不需要入库）
/docs/ios-trial/
# 前端构建产物（源码在 frontend/，产物不入库；壳内 assets 是已构建快照、另行入库）
dist/
dist-*
# Vite/构建临时文件
*.timestamp-*.mjs
# 环境变量与密钥（严禁入库；.env.example 可留作模板）
.env
.env.*
!.env.example
!.env.trial
!.env.trial.example
# 签名 / 证书
*.keystore
*.jks
*.p12
certdata
certini
# 原生宿主构建时由 frontend/dist 生成的 Web 资源（不入库；壳内 assets 走 xingce-app-shell）
android-host/app/src/main/assets/
android-host/app/src/trialAssets/
# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db
android-host/.kotlin/
# 本机截图/临时（不入库）
.shots/
# 真题PDF 大文件：不入库（入库脚本从本地真题PDF源生成，重打包时注入 App）
真题PDF源/
frontend/public/zhenti-pdf/
xingce-app-shell/zhenti-pdf/
frontend/dist/zhenti-pdf/
